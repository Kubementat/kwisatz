#!/usr/bin/env bash
# shellcheck shell=bash
# =============================================================================
# asb — run a coding agent inside a bubblewrap (bwrap) sandbox
# =============================================================================
#
# Runs a coding agent (pi, opencode, claude, codex) or a bare shell (sh)
# inside a bwrap
# sandbox in which the workspace is the ONLY general writable path
# (explicit --bind dirs are deliberate exceptions):
#
#   - system dirs read-only: /usr /lib /lib64 /bin /sbin
#   - /etc per-file only (resolv.conf, hosts, passwd, group, ssl) — the
#     rest of /etc (shadow, sudoers, ...) is invisible
#   - agent state: ~/.local/bin, ~/.config/opencode read-only;
#     ~/.pi, ~/.local/share/opencode rw (agents write sessions,
#     logs, and their db there — ro breaks them);
#     claude: ~/.local/share/claude ro (native binary), ~/.claude and
#     ~/.claude.json rw (transcripts, credentials, settings);
#     codex: ~/.codex rw (config.toml, auth.json, sessions, logs — and
#     the binary itself for standalone installs); missing dirs skipped
#   - skills/prompts/commands in the agent's state dirs are often
#     symlinks into other home dirs (shared skill repos); their resolved
#     targets are bound ro so they keep working in-sandbox (dangling
#     links are skipped)
#   - herdr socket bind-mounted rw (if present) + ALL HERDR_* env vars
#     forwarded, so the agent's herdr state extension keeps working; asb
#     exports HERDR_AGENT=<agent> on the host side so herdr maps the
#     foreground bwrap process to the right agent manifest
#   - env is cleared; only HOME, PATH, TERM, LANG/LC_*, HERDR_* and
#     user-supplied --env vars are passed in
#   - namespaces: --unshare-uts --unshare-ipc (deliberately NO
#     --unshare-pid / --new-session in v1, so herdr foreground detection
#     and Ctrl-C keep working), --die-with-parent for the lifecycle
#
# NOT isolated in v1: the network (agents must reach the LLM API; an egress
# allowlist proxy is a planned follow-up).
#
# Usage:
#   asb <agent> [workspace] [args...]
#
#   agents:    pi | opencode | claude | codex | sh
#   workspace: optional ABSOLUTE path — the only writable dir (default: $PWD)
#
# Options:
#   --env KEY=VALUE       extra env var passed into the sandbox (repeatable)
#   --ro-bind HOST[:DEST] extra read-only bind; DEST defaults to HOST
#                         (repeatable)
#   --bind HOST[:DEST]    extra writable bind; DEST defaults to HOST
#                         (repeatable)
#   --debug-argv          print the bwrap command line and exit (does not exec)
#   -h, --help            show this help
#
# Examples:
#   asb pi                          # sandboxed pi in the current dir
#   asb pi /srv/projects/myrepo     # sandboxed pi in a given workspace
#   (from ~: asb pi uses the private sandbox /tmp as scratch area —
#    pass an explicit absolute workspace to bind a real dir instead)
#   asb pi -p "say hi"              # one-shot (batch) run
#   asb opencode /path/to/repo
#   asb claude /path/to/repo
#   asb claude --env ANTHROPIC_API_KEY=...   # API-key auth into the sandbox
#   asb codex /path/to/repo
#   asb sh -c 'ls'                  # bare sandboxed shell (diagnostics)
# =============================================================================

set -euo pipefail

PROG="asb"
err() { echo "${PROG}: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
asb — run a coding agent inside a bubblewrap (bwrap) sandbox

Usage:
  asb <agent> [workspace] [args...]

Agents:
  pi          sandboxed Pi coding agent
  opencode    sandboxed Opencode agent
  claude      sandboxed Claude Code agent
  codex       sandboxed OpenAI Codex CLI agent
  sh          bare sandboxed shell (diagnostics)

Arguments:
  workspace   optional ABSOLUTE path, the only writable dir (default: $PWD)
  args        passed through to the agent

Options:
  --env KEY=VALUE       extra env var passed into the sandbox (repeatable)
  --ro-bind HOST[:DEST] extra read-only bind; DEST defaults to HOST
                        (repeatable; both must be absolute, existing dirs)
  --bind HOST[:DEST]    extra writable bind; DEST defaults to HOST
                        (repeatable; both must be absolute, existing dirs)
  --debug-argv          print the bwrap command line and exit (does not exec)
  -h, --help            show this help

Guarantees (v1):
  - workspace is the only general writable path (/tmp is a private
    tmpfs; when the default workspace would be $HOME, asb uses the
    private /tmp instead of binding $HOME); user --bind dirs are
    deliberate exceptions
  - /usr /lib /lib64 /bin /sbin are read-only; /etc is per-file
    (resolv.conf, hosts, passwd, group, ssl) — shadow/sudoers are invisible
  - --ro-bind HOST[:DEST] (repeatable) adds extra read-only binds; DEST
    defaults to HOST when omitted
  - --bind HOST[:DEST] (repeatable) adds extra writable binds; DEST
    defaults to HOST when omitted
  - agent state: ~/.local/bin, ~/.config/opencode read-only; ~/.pi,
    ~/.local/share/opencode, ~/.claude and ~/.claude.json (claude) and
    ~/.codex (codex, incl. its standalone binary) rw — agents write
    sessions/logs/credentials there; missing dirs are skipped
  - symlinked skills/prompts/commands in those state dirs get their
    resolved targets bound read-only (dangling links are skipped)
  - env is cleared; only HOME, PATH, TERM, LANG/LC_*, HERDR_* and
    --env vars are forwarded
  - herdr socket is bind-mounted rw (if present) and HERDR_* vars are
    forwarded; HERDR_AGENT=<agent> is exported on the host side
  - namespaces: --unshare-uts --unshare-ipc, --die-with-parent
    (no --unshare-pid / --new-session in v1: keeps herdr foreground
    detection and Ctrl-C working)

Limits (v1):
  - no network isolation (agents must reach the LLM API; an egress
    allowlist proxy is a planned follow-up)
  - agent state dirs are writable in-sandbox, same as an unsandboxed
    same-uid run (bounding deliberate state tampering is the
    microVM tier's threat model, not this one)
  - the mounted herdr socket grants the agent the same herdr access a
    same-uid unsandboxed agent already has

Examples:
  asb pi
  asb pi /srv/projects/myrepo
  asb pi -p "say hi"
  asb opencode /path/to/repo
  asb claude /path/to/repo
  asb claude --env ANTHROPIC_API_KEY=... # API-key auth (subscription/OAuth
                                        # creds in ~/.claude/.credentials.json
                                        # are already carried by the rw mount)
  asb codex /path/to/repo
  asb sh -c 'ls'
  asb pi /srv/projects/myrepo --bind /srv/projects/myrepo-main/.git
     # make the backing .git of a linked git worktree writable in-sandbox
EOF
}

# ---------------------------------------------------------------------------
# Parse arguments: first positional is the agent, then options and pass-through
# ---------------------------------------------------------------------------

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

AGENT="$1"
shift
case "$AGENT" in
  pi | opencode | claude | codex | sh) ;;
  *) err "unknown agent: '${AGENT}' (supported: pi, opencode, claude, codex, sh)" ;;
esac

REST=("$@")
WORKSPACE=""
WORKSPACE_EXPLICIT=0
ENV_OVERRIDES=()
RO_BINDS_HOST=()
RO_BINDS_DEST=()
BINDS_HOST=()
BINDS_DEST=()
AGENT_ARGS=()
DEBUG_ARGV=0

i=0
while (( i < ${#REST[@]} )); do
  arg="${REST[i]}"
  case "$arg" in
    --env)
      if (( i + 1 >= ${#REST[@]} )); then
        err "--env requires a KEY=VALUE argument"
      fi
      ENV_OVERRIDES+=("${REST[i+1]}")
      i=$((i + 2))
      continue
      ;;
    --debug-argv)
      DEBUG_ARGV=1
      i=$((i + 1))
      continue
      ;;
    --ro-bind)
      if (( i + 1 >= ${#REST[@]} )); then
        err "--ro-bind requires a HOST[:DEST] argument"
      fi
      ro_spec="${REST[i+1]}"
      if [[ "$ro_spec" == *:* ]]; then
        ro_host="${ro_spec%%:*}"
        ro_dest="${ro_spec#*:}"
      else
        ro_host="$ro_spec"
        ro_dest="$ro_spec"
      fi
      # Validate: both paths must be absolute
      if [[ "$ro_host" != /* ]]; then
        err "--ro-bind: host path must be absolute (got: '${ro_host}')"
      fi
      if [[ "$ro_dest" != /* ]]; then
        err "--ro-bind: dest path must be absolute (got: '${ro_dest}')"
      fi
      # Validate: both must exist
      if [[ ! -e "$ro_host" ]]; then
        err "--ro-bind: host path does not exist (got: '${ro_host}')"
      fi
      if [[ ! -e "$ro_dest" ]]; then
        err "--ro-bind: dest path does not exist (got: '${ro_dest}')"
      fi
      # Validate: both must be directories
      if [[ ! -d "$ro_host" ]]; then
        err "--ro-bind: host path is not a directory (got: '${ro_host}')"
      fi
      if [[ ! -d "$ro_dest" ]]; then
        err "--ro-bind: dest path is not a directory (got: '${ro_dest}')"
      fi
      RO_BINDS_HOST+=("$ro_host")
      RO_BINDS_DEST+=("$ro_dest")
      i=$((i + 2))
      continue
      ;;
    --bind)
      if (( i + 1 >= ${#REST[@]} )); then
        err "--bind requires a HOST[:DEST] argument"
      fi
      bind_spec="${REST[i+1]}"
      if [[ "$bind_spec" == *:* ]]; then
        bind_host="${bind_spec%%:*}"
        bind_dest="${bind_spec#*:}"
      else
        bind_host="$bind_spec"
        bind_dest="$bind_spec"
      fi
      # Validate: both paths must be absolute
      if [[ "$bind_host" != /* ]]; then
        err "--bind: host path must be absolute (got: '${bind_host}')"
      fi
      if [[ "$bind_dest" != /* ]]; then
        err "--bind: dest path must be absolute (got: '${bind_dest}')"
      fi
      # Validate: both must exist
      if [[ ! -e "$bind_host" ]]; then
        err "--bind: host path does not exist (got: '${bind_host}')"
      fi
      if [[ ! -e "$bind_dest" ]]; then
        err "--bind: dest path does not exist (got: '${bind_dest}')"
      fi
      # Validate: both must be directories
      if [[ ! -d "$bind_host" ]]; then
        err "--bind: host path is not a directory (got: '${bind_host}')"
      fi
      if [[ ! -d "$bind_dest" ]]; then
        err "--bind: dest path is not a directory (got: '${bind_dest}')"
      fi
      BINDS_HOST+=("$bind_host")
      BINDS_DEST+=("$bind_dest")
      i=$((i + 2))
      continue
      ;;
  esac
  # First absolute existing-dir argument (before any pass-through arg)
  # is the workspace.
  if [[ -z "$WORKSPACE" && ${#AGENT_ARGS[@]} -eq 0 && "$arg" == /* && -d "$arg" ]]; then
    WORKSPACE="$arg"
    WORKSPACE_EXPLICIT=1
    i=$((i + 1))
    continue
  fi
  AGENT_ARGS+=("$arg")
  i=$((i + 1))
done

# ---------------------------------------------------------------------------
# Workspace (the only general writable path)
# ---------------------------------------------------------------------------

if [[ -z "$WORKSPACE" ]]; then
  WORKSPACE="$PWD"
fi
[[ -d "$WORKSPACE" ]] || err "workspace is not a directory: ${WORKSPACE}"
if [[ "$WORKSPACE" == "$HOME" || "$HOME" == "$WORKSPACE"/* ]]; then
  if [[ "$WORKSPACE_EXPLICIT" -eq 1 ]]; then
    err "refusing workspace '${WORKSPACE}': it is (or contains) \$HOME, which would make agent state writable"
  else
    # Defaulted to a home dir: fall back to the private /tmp tmpfs so the
    # sandbox still has a writable scratch area without exposing $HOME.
    echo "asb: default workspace is \$HOME — using the private sandbox /tmp instead (pass an explicit workspace to bind a real dir)" >&2
    WORKSPACE=""
    BWRAP_FALLBACK_CHDIR=1
  fi
fi

# ---------------------------------------------------------------------------
# Resolve the agent binary and make its runtime visible in the sandbox
# ---------------------------------------------------------------------------

RO_EXTRA_DIRS=()

# add_ro_dir DIR — remember a directory to ro-bind, unless it is already
# covered by the static system mounts (/usr /bin /sbin /lib /lib64).
add_ro_dir() {
  local d x
  d="$(realpath -- "$1" 2>/dev/null)" || return 0
  case "$d" in
    /usr | /usr/* | /bin | /bin/* | /sbin | /sbin/* | /lib | /lib/* | /lib64 | /lib64/*)
      return 0
      ;;
  esac
  for x in "${RO_EXTRA_DIRS[@]}"; do
    [[ "$x" == "$d" ]] && return 0
  done
  RO_EXTRA_DIRS+=("$d")
}

if [[ "$AGENT" == "sh" ]]; then
  AGENT_BIN="$(command -v sh)" || err "no 'sh' found on PATH"
else
  AGENT_BIN="$(command -v "$AGENT" 2>/dev/null)" || {
    echo "${PROG}: agent '${AGENT}' not found on PATH — install it first (e.g. ./tasks/setup-pi.sh, ./tasks/setup-opencode.sh, 'claude install', or the codex standalone installer)" >&2
    exit 1
  }
fi

add_ro_dir "$(dirname -- "$AGENT_BIN")"

AGENT_REAL="$(readlink -f -- "$AGENT_BIN")"
[[ -f "$AGENT_REAL" ]] || err "cannot resolve agent binary: ${AGENT_BIN}"

# JS packages: bind the package root (nearest ancestor dir holding a
# package.json) so nested node_modules siblings resolve; fall back to
# the file's own dir for non-package binaries.
js_root="$(dirname -- "$AGENT_REAL")"
probe="$js_root"
for _ in 1 2 3 4 5 6; do
  if [[ -f "$probe/package.json" ]]; then
    js_root="$probe"
    break
  fi
  parent="$(dirname -- "$probe")"
  [[ "$parent" == "$probe" ]] && break
  probe="$parent"
done
add_ro_dir "$js_root"

# npm-installed agents are env-node scripts: mount the node runtime as well.
# (od-encoding keeps binary nulls out of command substitution)
magic_hex="$(head -c 2 -- "$AGENT_REAL" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
if [[ "$magic_hex" == "2321" ]]; then
  first_line="$(head -n 1 -- "$AGENT_REAL" 2>/dev/null || true)"
  if [[ "$first_line" == *" node" ]]; then
    NODE_BIN="$(command -v node 2>/dev/null)" || err "agent '${AGENT}' requires node, but no 'node' found on PATH"
    add_ro_dir "$(dirname -- "$NODE_BIN")"
    NODE_REAL="$(readlink -f -- "$NODE_BIN")"
    add_ro_dir "$(dirname -- "$NODE_REAL")"
  fi
fi

# ---------------------------------------------------------------------------
# Environment allowlist (never inherit the host env — it carries tokens)
# ---------------------------------------------------------------------------

# Print the env entries allowed into the sandbox, NUL-separated:
# HOME, PATH, TERM, LANG, LC_*, HERDR_* (incl. the HERDR_AGENT export).
sandbox_env_kv() {
  local kv name
  while IFS= read -r -d '' kv; do
    name="${kv%%=*}"
    case "$name" in
      HOME | PATH | TERM | LANG | LC_* | HERDR_*) printf '%s\0' "$kv" ;;
    esac
  done < <(env -0)
}

# ---------------------------------------------------------------------------
# Agent state symlinks (skills/prompts pointing outside the mounted dirs)
# ---------------------------------------------------------------------------

# Skills/prompts/commands live in per-agent content dirs that are bind-mounted
# for the agent's state (above). Their entries are often symlinks into other
# home dirs (e.g. a shared skill repo). bwrap cannot resolve targets that are
# not bound, so mount each distinct resolved target ro — dangling links
# (target missing on the host) are skipped. Project-level dirs (.opencode/,
# .claude/, .agents/ inside the repo) need no handling: they live inside the
# workspace bind.
STATE_CONTENT_DIRS=()
case "$AGENT" in
  pi)
    STATE_CONTENT_DIRS=(
      "$HOME/.pi/agent/skills" "$HOME/.pi/agent/prompts"
      "$HOME/.agents/skills") ;;
  opencode)
    # global config dirs + the Claude/agent-compatible skill dirs opencode
    # also scans
    STATE_CONTENT_DIRS=(
      "$HOME/.config/opencode/skills" "$HOME/.config/opencode/commands"
      "$HOME/.claude/skills" "$HOME/.agents/skills") ;;
  claude)
    STATE_CONTENT_DIRS=(
      "$HOME/.claude/skills" "$HOME/.claude/commands") ;;
  codex)
    STATE_CONTENT_DIRS=(
      "$HOME/.codex/skills" "$HOME/.codex/prompts") ;;
  sh) : ;;
esac

STATE_SYMLINK_TARGETS=()
add_state_link_target() {
  local t x
  t="$(readlink -f -- "$1" 2>/dev/null)" || return 0
  [[ -e "$t" ]] || return 0
  for x in "${STATE_SYMLINK_TARGETS[@]}"; do
    [[ "$x" == "$t" ]] && return 0
  done
  STATE_SYMLINK_TARGETS+=("$t")
}
for d in "${STATE_CONTENT_DIRS[@]}"; do
  for f in "$d"/*; do
    [[ -L "$f" ]] && add_state_link_target "$f"
  done
done

# ---------------------------------------------------------------------------
# Build the bwrap argv
# ---------------------------------------------------------------------------

HERDR_SOCK="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"

BWRAP_ARGV=(
  bwrap
  --ro-bind /usr /usr
  --ro-bind /lib /lib
  --ro-bind /lib64 /lib64
  --ro-bind /bin /bin
  --ro-bind /sbin /sbin
  --ro-bind-try /etc/resolv.conf /etc/resolv.conf
  --ro-bind /etc/hosts /etc/hosts
  --ro-bind /etc/passwd /etc/passwd
  --ro-bind /etc/group /etc/group
  --ro-bind-try /etc/ssl /etc/ssl
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  # pi writes session dirs under ~/.pi → rw (ro breaks session creation)
  --bind-try "$HOME/.pi" "$HOME/.pi"
  --ro-bind-try "$HOME/.config/opencode" "$HOME/.config/opencode"
  # opencode writes its log + sqlite db under its share dir → rw
  --bind-try "$HOME/.local/share/opencode" "$HOME/.local/share/opencode"
  # claude: native installer keeps the real binary under
  # ~/.local/share/claude/versions (the ~/.local/bin/claude launcher is a
  # symlink into it) → ro
  --ro-bind-try "$HOME/.local/share/claude" "$HOME/.local/share/claude"
  # claude writes transcripts (~/.claude/projects), history, settings and
  # its Linux credentials (~/.claude/.credentials.json) at runtime → rw;
  # a few global config keys live in ~/.claude.json → rw
  --bind-try "$HOME/.claude" "$HOME/.claude"
  --bind-try "$HOME/.claude.json" "$HOME/.claude.json"
  # codex: CODEX_HOME default ~/.codex holds config.toml, auth.json,
  # history.jsonl, sessions, logs — and for standalone installs the
  # binary itself (packages/standalone/current/codex) → rw (a per-agent
  # RO_EXTRA_DIRS ro-bind of the exact binary dir layers on top)
  --bind-try "$HOME/.codex" "$HOME/.codex"
  --ro-bind-try "$HOME/.local/bin" "$HOME/.local/bin"
  # shared agent-skill dir scanned by pi and opencode (Claude-compatible
  # ~/.claude/skills is covered by the ~/.claude rw bind above)
  --ro-bind-try "$HOME/.agents" "$HOME/.agents"
)

for d in "${RO_EXTRA_DIRS[@]}"; do
  BWRAP_ARGV+=(--ro-bind "$d" "$d")
done

# user-supplied --ro-bind HOST[:DEST] (repeatable)
for (( idx=0; idx<${#RO_BINDS_HOST[@]}; idx++ )); do
  BWRAP_ARGV+=(--ro-bind "${RO_BINDS_HOST[$idx]}" "${RO_BINDS_DEST[$idx]}")
done

# user-supplied --bind HOST[:DEST] (repeatable) — additional writable mounts;
# emitted before the workspace bind so a nested workspace still wins
for (( idx=0; idx<${#BINDS_HOST[@]}; idx++ )); do
  BWRAP_ARGV+=(--bind "${BINDS_HOST[$idx]}" "${BINDS_DEST[$idx]}")
done

# skills/prompts symlink targets (ro) — see add_state_link_target above
for t in "${STATE_SYMLINK_TARGETS[@]}"; do
  BWRAP_ARGV+=(--ro-bind-try "$t" "$t")
done

# herdr socket (rw) — skip cleanly when herdr is not installed/running
BWRAP_ARGV+=(--bind-try "$HERDR_SOCK" "$HERDR_SOCK")

if [[ -n "$WORKSPACE" ]]; then
  # workspace: the only general writable path; start inside it (or in the
  # original cwd when that lives inside the workspace)
  CHDIR_TARGET="$WORKSPACE"
  if [[ "$PWD" == "$WORKSPACE" || "$PWD" == "$WORKSPACE"/* ]]; then
    CHDIR_TARGET="$PWD"
  fi
  BWRAP_ARGV+=(--bind "$WORKSPACE" "$WORKSPACE" --chdir "$CHDIR_TARGET")
elif [[ "${BWRAP_FALLBACK_CHDIR:-0}" -eq 1 ]]; then
  # no writable bind (home-dir default): private /tmp is the scratch area
  BWRAP_ARGV+=(--chdir /tmp)
fi

# namespaces & lifecycle (v1: no --unshare-pid, no --new-session)
BWRAP_ARGV+=(--unshare-uts --unshare-ipc --die-with-parent --clearenv)

while IFS= read -r -d '' kv; do
  BWRAP_ARGV+=(--setenv "${kv%%=*}" "${kv#*=}")
done < <(sandbox_env_kv)

for e in "${ENV_OVERRIDES[@]}"; do
  [[ "$e" == *=* && -n "${e%%=*}" ]] || err "--env requires KEY=VALUE (got: '${e}')"
  BWRAP_ARGV+=(--setenv "${e%%=*}" "${e#*=}")
done

BWRAP_ARGV+=(-- "$AGENT_BIN" "${AGENT_ARGS[@]}")

if (( DEBUG_ARGV )); then
  for a in "${BWRAP_ARGV[@]}"; do
    printf '%q ' "$a"
  done
  printf '\n'
  exit 0
fi

# Host-side herdr hint: maps the foreground bwrap process to the agent's
# screen manifest (herdr "VMs and sandbox wrappers" pattern).
export HERDR_AGENT="$AGENT"

exec "${BWRAP_ARGV[@]}"
