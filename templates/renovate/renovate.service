[Unit]
Description=Renovate run (versions.yml bump PRs) — generated by tasks/setup-renovate.sh
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=${DOCKER_BIN} run --rm --name renovate \
  --env-file ${RENOVATE_DIR}/.env \
  -e RENOVATE_CONFIG_FILE=/usr/src/app/config.js \
  -e RENOVATE_BASE_DIR=/tmp/renovate \
  -e LOG_LEVEL=${RENOVATE_LOG_LEVEL} \
  -v ${RENOVATE_DIR}/config.js:/usr/src/app/config.js:ro \
  -v ${RENOVATE_DIR}/cache:/tmp/renovate \
  ${RENOVATE_IMAGE}
TimeoutStartSec=1h
